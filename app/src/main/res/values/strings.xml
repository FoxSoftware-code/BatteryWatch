    <string name="finding_screen_off_drain_title">Screen off: %1$.1f%%/h (normal &lt; 1%%/h)</string>
    <string name="finding_screen_off_drain_detail">During %1$s with the screen off the battery dropped %2$d%% (%3$d mAh). The causes are listed below.</string>
    <string name="finding_screen_on_title">The screen is %1$d%% of usage, often at high brightness</string>
    <string name="finding_screen_on_detail">Screen on: %1$.1f%%/h, %2$.0f%% of the time in the highest brightness bucket.</string>
    <string name="finding_auto_brightness_off">Auto-brightness is off.</string>
    <string name="finding_timeout_title">Screen turns off only after %1$s</string>
    <string name="finding_timeout_detail">Every time you put the phone down without locking it, the screen stays lit for nothing.</string>
    <string name="finding_flashlight_title">Flashlight was on for %1$s with the screen off</string>
    <string name="finding_flashlight_mah">%1$d mAh.</string>
    <string name="finding_flashlight_by">%1$d mAh, turned on by: %2$s.</string>
    <string name="finding_flashlight_gesture">Most likely a screen-off gesture turns it on in your pocket.</string>
    <string name="finding_connectivity_title">Unstable connection (network changes: %1$d)</string>
    <string name="finding_connectivity_detail">Wi-Fi was disconnected for %1$s and the cellular signal was weak %2$.0f%% of the time. Every switch wakes up the modem and the CPU. Turning off automatic Wi-Fi/mobile data switching (Wi-Fi assistant) and forgetting weak networks helps.</string>
    <string name="finding_multicast_title">Wi-Fi multicast held a wakelock for %1$s</string>
    <string name="finding_multicast_detail">Usually apps that discover devices on the network (Chromecast, cameras, smart home).</string>
    <string name="finding_doze_title">Deep Doze only %1$.0f%% of screen-off time</string>
    <string name="finding_doze_detail">The phone rarely falls fully asleep. Causes: motion (pocket), app wakelocks and alarms, gestures, the flashlight.</string>
    <string name="finding_scanning_title">Wi-Fi/Bluetooth scanning runs even when they are off</string>
    <string name="finding_scanning_detail">Total Bluetooth scanning: %1$s. Turning it off slightly reduces indoor location accuracy.</string>
    <string name="finding_bg_title">%1$s uses battery with the screen off (%2$d mAh)</string>
    <string name="finding_bg_detail">Background: %1$s, foreground service: %2$s, CPU time: %3$s, wakeup alarms: %4$d.</string>
    <string name="finding_alarms_title">%1$s wakes the phone %2$d× (alarms)</string>
    <string name="finding_alarms_detail">Frequent wakeup alarms keep the phone from sleeping deeply.</string>
    <string name="finding_charging_heavy_title">%1$s works hard while charging (%2$d mAh)</string>
    <string name="finding_charging_heavy_detail">It doesn\'t drain the battery, but it heats it up while charging, which speeds up battery wear.</string>
    <string name="finding_wakelock_title">Wakelock %1$s: %2$s</string>
    <string name="finding_wakelock_detail">%1$s (%2$d×). Audio/music playback is a normal reason.</string>
    <string name="finding_health_title">The battery may have about %1$.0f%% of its capacity</string>
    <string name="finding_health_detail">Charge counter: %1$d mAh at %2$d%% → ~%3$d of %4$d mAh. This is an estimate; check Settings → Battery → Battery health.</string>
    <string name="note_temp_high_title">Very high temperature (%1$.1f °C)</string>
    <string name="note_temp_high_detail">Charging above 45 °C wears the battery out fastest. Remove the case, don\'t charge under a pillow or while gaming.</string>
    <string name="note_temp_warm_title">The phone got warm while charging (%1$.1f °C)</string>
    <string name="note_temp_warm_detail">Above 40 °C for %1$.0f min. Most common causes: using the phone, a case, a warm room.</string>
    <string name="note_throttled_title">Charging slowed down because of temperature</string>
    <string name="note_throttled_detail">For %1$.0f min the current dropped below 60%% of its peak at ≥ 39 °C, even though the battery was below 80%%.</string>
    <string name="note_at_full_title">The phone sat at 100%% for a long time (%1$.1f h)</string>
    <string name="note_at_full_detail" formatted="false">Keeping a full battery on the charger speeds up wear. Turn on “Optimized charging” or the 80% limit in battery settings, or set an alert at 80–90% here.</string>
    <string name="note_screen_use_title">Using the phone slowed down charging</string>
    <string name="note_screen_use_detail">Screen on %1$.0f%% of the time: on average %2$d mA into the battery with the screen on, %3$d mA with it off.</string>
    <string name="note_slow_title">Slow charging (peak %1$.1f W)</string>
    <string name="note_slow_charger">The charger reports up to %1$.0f W.</string>
    <string name="note_slow_detail">A weak cable, a computer USB port or a charger without fast charging. OnePlus/OPPO phones charge fast only with a SUPERVOOC charger.</string>
    <string name="note_paused_title">Charging paused for %1$.0f min</string>
    <string name="note_paused_detail" formatted="false">The system paused charging while plugged in (smart/optimized charging, 80% limit or temperature).</string>
    <string name="note_capacity_title">Estimated capacity: %1$d mAh (%2$.0f%% of design)</string>
    <string name="note_capacity_detail_counter">From the charge added between %1$d%% and %2$d%% (charge counter). A single measurement can be off by ±10%%; see the average of several sessions.</string>
    <string name="note_capacity_detail_integral">From the charge added between %1$d%% and %2$d%% (current integral, less accurate). A single measurement can be off by ±10%%; see the average of several sessions.</string>
